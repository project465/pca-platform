# 커리어메트리 플랫폼 환경변수. 값을 지어내지 않았다 — 비어 있으면 그 기능이 꺼진다.

# ── 반드시 있어야 하는 것 ────────────────────────────────────────
DATABASE_URL=postgres://metri:비밀번호@db:5432/metri
# 세션 서명 키. 32바이트 이상. `openssl rand -base64 48` 로 만든다
AUTH_SECRET=
POSTGRES_PASSWORD=

# ── 결제 (PG 가맹점 심사가 끝나면 채운다) ────────────────────────
# 비어 있으면 결제 버튼을 아예 그리지 않는다 — 누르면 오류가 나는
# 버튼은 안내가 아니다(`checkoutReady()`)
#
# 어느 대행사로 받는가. 비우면 `mock`(가짜)이고, 운영에서 mock 이면
# 코드가 거절한다: 돈을 안 받고 이용권이 나가는 사고는 설정 실수 하나로
# 일어난다
PAYMENTS_PROVIDER=
PORTONE_STORE_ID=
PORTONE_API_SECRET=
# 웹훅 서명 시크릿(base64). **없으면 웹훅을 검증할 수 없다** — 검증 못 하는
# 웹훅을 받으면 아무나 '결제됐다' 고 알려서 이용권을 받아 갈 수 있다
PORTONE_WEBHOOK_SECRET=
# 국내 카드 채널
PORTONE_CHANNEL_KEY=
# 해외 카드 채널. **비어 있으면 해외 결제가 닫힌다**(국내 PG 의 일반
# 카드결제로는 해외 발급 Visa·Mastercard 가 승인되지 않는다).
# 해외 PG 가 아직 정해지지 않았다 — `marketReadiness('GLOBAL')` 이
# 그 사실을 값으로 돌려주고 `commercial:check` 가 블로커로 센다
PORTONE_CHANNEL_KEY_GLOBAL=

# ── 메일 (없으면 보내지 않고 대기열에만 쌓는다) ──────────────────
# 자격증명이 붙는 순간 쌓여 있던 것이 순서대로 나간다
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=

# ── 운영 ────────────────────────────────────────────────────────
# 메일 본문에 들어갈 주소. 비어 있으면 링크 없는 문면이 나간다
PLATFORM_URL=
# 재고 경고를 받을 사람. 비어 있으면 MAIL_FROM 으로 간다
OPS_EMAIL=
# 응시권 코드 재고가 이 수 아래로 떨어지면 브리핑이 경고한다
CODE_STOCK_MIN=20
# /api/ops/tick 을 두드릴 때 쓰는 토큰. 16자 미만이면 그 주소가 닫힌다
# `openssl rand -hex 24` 로 만든다
OPS_TOKEN=
# 개발용 가짜 결제. 운영에서는 절대 켜지 않는다
# 옛 열쇠. **이제 아무 문도 열지 않는다** — 운영에서 가짜 결제를 켜는
# 길은 없앴다(`src/lib/env.ts`). 판단은 아래 APP_ENV 가 한다
ALLOW_MOCK_PAYMENTS=
