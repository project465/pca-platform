# PostgreSQL 접속 문자열
DATABASE_URL=postgres://postgres@127.0.0.1:5432/pca

# 세션 쿠키 서명 키. openssl rand -base64 32 으로 생성한다
AUTH_SECRET=

# 배포 주소. 비밀번호 재설정 링크를 만들 때 쓴다
AUTH_URL=http://localhost:3000

# 소개 사이트가 도입 신청을 넘길 때 대는 값. 소개 사이트 쪽과 같아야 한다
INTAKE_SECRET=

# 메일 발송. smtp 면 실제로 보내고, log 면 .mail/outbox.jsonl 에만 남긴다
MAIL_TRANSPORT=log
MAIL_FROM=PCA <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── 운영에서 ──
# 위 값이 비었거나 검사용 기본값이면 서버가 뜨지 않는다
# (src/instrumentation.ts). 무엇이 빠졌는지 찍고 멈춘다.
#   AUTH_SECRET    32자 이상. openssl rand -base64 32
#   AUTH_URL       실제 https 주소. 메일 링크가 여기서 만들어진다
#   INTAKE_SECRET  16자 이상. 소개 사이트와 같은 값
#   MAIL_TRANSPORT smtp 여야 한다. log 면 메일이 파일에만 쌓인다
# 자세한 것은 docs/DEPLOY.md
