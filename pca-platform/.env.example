# PostgreSQL 접속 문자열
DATABASE_URL=postgres://postgres@127.0.0.1:5432/pca

# 세션 쿠키 서명 키. openssl rand -base64 32 으로 생성한다
AUTH_SECRET=

# 배포 주소. 비밀번호 재설정 링크를 만들 때 쓴다
AUTH_URL=http://localhost:3000

# ---------- 현멘 (현직자 멘토링) ----------
# 줌 Server-to-Server OAuth 앱의 값. 운영사 계정 하나로 회의를 만든다.
# 멘토에게 줌 계정을 요구하지 않으므로 멘토 이메일이 회의에 남지 않는다.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# 회의를 만들 계정. 기본값 me (앱에 연결된 계정 소유자)
ZOOM_HOST_USER=me
# 회의 시간대. 멘토가 시간대를 열 때 입력값을 이 기준으로 해석한다
MEETING_TIMEZONE=Asia/Seoul
# 줌 없이 화면만 확인할 때 1. 가짜 링크가 만들어지므로 운영에서는 절대 쓰지 않는다
ZOOM_DRY_RUN=

# 알림 메일 발송. scripts/notify.ts 가 이 주소로 POST {from,to,subject,text} 한다
# 발송 업체를 아직 정하지 않아 웹훅 한 겹으로 빼 두었다. 없으면 큐에 그대로 남는다
MAIL_WEBHOOK_URL=
MAIL_WEBHOOK_TOKEN=
MAIL_FROM=no-reply@careerpeak.co.kr

# ---------- 개인 결제 (현멘) ----------
# 토스페이먼츠. 클라이언트 키는 브라우저로 나가므로 NEXT_PUBLIC_ 접두사가 필요하다
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
# 결제창 없이 흐름만 볼 때 1. 운영에서는 절대 쓰지 않는다
PAYMENTS_DRY_RUN=
