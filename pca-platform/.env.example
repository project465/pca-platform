# PostgreSQL 접속 문자열
DATABASE_URL=postgres://postgres@127.0.0.1:5432/pca

# 세션 쿠키 서명 키. openssl rand -base64 32 으로 생성한다
AUTH_SECRET=

# 배포 주소. 비밀번호 재설정 링크를 만들 때 쓴다
AUTH_URL=http://localhost:3000

# ── 결제 ─────────────────────────────────────────
# mock | portone.  기본값 mock. 운영에서 mock 이면 서버가 뜨지 않는다
PAYMENTS_PROVIDER=mock

# PortOne V2. 가맹점 심사가 끝나면 채운다
# storeId·channelKey 는 브라우저로 나가는 공개값이고, 아래 둘은 서버에만 둔다
PORTONE_STORE_ID=
PORTONE_CHANNEL_KEY=
# 해외 발급 Visa·Mastercard 용 채널. 국내 PG 일반 카드결제로는 승인되지 않는다
PORTONE_CHANNEL_KEY_GLOBAL=
PORTONE_API_SECRET=
PORTONE_WEBHOOK_SECRET=
