
# 로컬 검증용 임시 산출물
# **개발용 계정의 열쇠.** 전에는 여섯 값이 소스와 README 에 평문으로
# 적혀 있었다. 운영 secret 은 아니지만 그 값으로 실제로 로그인이 된다
.dev-credentials.json
*.tsbuildinfo
.DS_Store
.env
.env*.local
.env.local
.next/
_shot.mjs
next-env.d.ts
node_modules/
npm-debug.log*
out/
var/reports/

# 지금 떠 있는 서버가 어느 빌드인지. 기계마다 다르다
var/.serving-build

# 지금 떠 있는 서버가 어느 Core 를 미리보기로 열어 두었는지.
# **등록부가 아니다**: 학생 공개 상태는 `major-cores.json` 이 정하고 이 파일은
# 눌러 보는 검사에게 "이 서버가 무엇을 열어 두었는가" 를 알려 주는 쪽지다.
var/.serving-preview
var/.serving-campus-fixture

# 검증하다 만든 임시 파일. 저장소에 남길 것이 아니다
var/tmp/
var/pdf-audit/

# PCU Coverage walk 산출물. 저장소에 올리지 않는다
var/pcu-coverage/
var/pdf-lab/

# 상용 콘텐츠 QA 가 떠 두는 실제 출력. 결과지 60벌 × 네 가지라 수백 MB 다
var/content-qa*/
var/pcu-content/
var/pcu-generic/
# 학과 여덟 항목 판정표. 명령을 다시 돌리면 다시 생긴다
var/pcu-dept/
# 갈래 아홉 항목 판정표(`pcu:spec`). 사람이 읽을 묶음은 `docs/metri/` 에 있다
var/pcu-spec/

# 띄워 둔 서버의 기록. 기계마다 다르고 저장소에 남길 것이 아니다
var/*.log

# BEFORE/AFTER 로 뜬 결과지 원본. 쪽 그림만 남긴다
docs/metri/shots/pcu-wow/**/report.pdf
var/pcu-readiness/

# 목표 화면을 재면서 떠 둔 자국(R24). **재는 자는 `scripts/lab/r24-*.ts`
# 이고 그 자국을 읽는 코드가 0 이다**: 남겨 두면 다음 사람이 이것을
# 기준값으로 읽는다
var/r24/
var/r30*/
var/r30-*
var/r31*/
var/r31-*
var/r32*/
var/r32-*
var/r33*/
var/r33-*

var/r34*/
var/r34-*

