diff --git a/src/lib/me-v3/report-gm/snapshot-inputs.ts b/src/lib/me-v3/report-gm/snapshot-inputs.ts
new file mode 100644
index 00000000..3b474a4d
--- /dev/null
+++ b/src/lib/me-v3/report-gm/snapshot-inputs.ts
@@ -0,0 +1,87 @@
+/**
+ * **제출하는 순간 Gold Master 입력(경험 기록)을 스냅샷과 같은 줄에 적는다**
+ * (Track E 요청 2 · Core 요청 1 의 바른 해법).
+ *
+ * 전에는 GM 이 처음 뽑히는 날 경험 기록을 모아 파일(`var/gm-inputs/`)로 굳혔다.
+ * 그 사이에 고친 기록은 되살릴 수 없어 빼야 했고(`edited_after`), 파일은
+ * 볼륨 · 재배포 · 파기를 따로 챙겨야 했다. 제출 트랜잭션 안에서 적으면 기준
+ * 시각이 **스냅샷의 `created_at` 과 같은 `now()`** 가 되고 파일이 필요 없다.
+ *
+ * **담는 칸은 아래 목록뿐이다.** `SELECT *` · `row_to_json(e)` 를 쓰지 않는다:
+ * 표에 칸이 늘면 그 칸이 말없이 굳은 줄로 들어온다. 특히 한 줄 메모
+ * (`note_text`)는 DB 가 1년 뒤 지우는 자유입력이라(`purge_after`) 굳은 줄에
+ * 들어가면 지운 뒤에도 남는다. GM 렌더는 그 칸을 읽지 않는다.
+ * `scripts/lab/trackE-r3.ts` S1 이 그 칸이 다시 들어오면 걸리는지 센다.
+ *
+ * 이 파일은 `pg` 의 형만 쓴다: 제출 경로(`runtime/session.ts`)가 GM 렌더 쪽
+ * 모듈을 끌어오지 않게 한다.
+ */
+import type { PoolClient } from "pg";
+
+/** 굳은 줄의 판본. 칸을 더하거나 빼면 올린다 */
+export const GM_SNAPSHOT_VERSION = "gm-snap.1";
+
+/**
+ * **GM 을 받을 수 있는 응시에만 적는다.** 모든 제출에 경험 기록 사본을 남기면
+ * GM 과 상관없는 사람의 글까지 한 벌 더 생긴다(개인정보 최소화). 등급을 올려
+ * 다시 제출하면 새 줄이 생기므로 그때 적힌다. 접근 판정(`access.ts`)도 이것을 읽는다.
+ */
+export const GM_CORES: readonly string[] = ["BIZ_CORE_V1"];
+export const GM_TIERS: readonly string[] = ["PRO"];
+export const gmEligible = (core: string, tier: string): boolean =>
+  GM_CORES.includes(core) && GM_TIERS.includes(tier);
+
+/**
+ * 경험 기록에서 GM 이 읽는 칸. **여기 없는 칸은 굳은 줄에 들어가지 않는다.**
+ * 빼는 칸: `note_text`(자유입력 · 1년 파기) · `purge_after` · `user_id`(줄이
+ * 이미 응시에 붙어 있다) · `core_code`(같은 값) · `updated_at`.
+ */
+export const GM_EXPERIENCE_COLUMNS = [
+  "id::text AS id", "kind", "title", "started_on::text AS started_on", "ended_on::text AS ended_on",
+  "td_codes", "axis_codes", "problems", "decisions", "artifacts", "verifications",
+  "used_where", "status", "created_at::text AS created_at",
+] as const;
+
+export type GmSnapshotInputs = {
+  version: typeof GM_SNAPSHOT_VERSION;
+  /** 스냅샷의 `created_at` 과 같은 값(같은 트랜잭션의 `now()`) */
+  frozen_at: string;
+  core: string;
+  experiences: Record<string, unknown>[];
+  /** 기준 시각 뒤에 만들어졌거나 고쳐진 기록. **제목을 담지 않는다**: 번호와 까닭만 */
+  excluded: { id: string; why: "created_after" | "edited_after" }[];
+};
+
+const ISO = `'YYYY-MM-DD"T"HH24:MI:SS.US"Z"'`;
+
+/**
+ * 제출 트랜잭션 안에서 부른다. `now()` 는 트랜잭션 하나에 한 값이라 여기서
+ * 읽은 시각이 곧 스냅샷 줄의 `created_at` 이다.
+ *
+ * 읽기 격리가 READ COMMITTED 라 이 문장 직전에 다른 트랜잭션이 넣은 기록이
+ * 보일 수 있다. 그 기록의 `created_at` 은 이 트랜잭션의 `now()` 보다 늦으므로
+ * 기준 시각 규칙(`<=`)으로 거른다.
+ */
+export async function gmInputsInTx(
+  c: PoolClient, userId: string, core: string,
+): Promise<GmSnapshotInputs> {
+  const at = await c.query<{ frozen: string }>(
+    `SELECT to_char(now() AT TIME ZONE 'UTC', ${ISO}) AS frozen`);
+  const frozen = at.rows[0].frozen;
+  const rows = await c.query<Record<string, unknown> & { _created: string; _updated: string | null }>(
+    `SELECT ${GM_EXPERIENCE_COLUMNS.join(", ")},
+            to_char(created_at AT TIME ZONE 'UTC', ${ISO}) AS _created,
+            to_char(updated_at AT TIME ZONE 'UTC', ${ISO}) AS _updated
+       FROM v3_experiences
+      WHERE user_id = $1 AND core_code = $2
+      ORDER BY created_at DESC, id DESC`, [userId, core]);
+  const experiences: Record<string, unknown>[] = [];
+  const excluded: GmSnapshotInputs["excluded"] = [];
+  for (const r of rows.rows) {
+    const { _created, _updated, ...rest } = r;
+    if (_created > frozen) excluded.push({ id: String(r.id), why: "created_after" });
+    else if (_updated && _updated > frozen) excluded.push({ id: String(r.id), why: "edited_after" });
+    else experiences.push(rest);
+  }
+  return { version: GM_SNAPSHOT_VERSION, frozen_at: frozen, core, experiences, excluded };
+}
