+/**
+ * **Gold Master PDF 를 누가 받는가**(Track E 요청 1 · 운영 입구의 권한).
+ *
+ * 차례대로 보고, 하나라도 걸리면 받지 못한다. **기본은 거절이다.**
+ *
+ *   1. 기능 플래그 `FEATURE_GM_REPORT=yes` 가 아니면 입구가 없다
+ *   2. 응시가 있어야 한다(번호 꼴이 아니면 DB 에 묻지도 않는다)
+ *   3. **본인만.** 기관 담당자 · 교수 · 운영사도 남의 GM 을 받지 못한다:
+ *      개인 결과지를 여는 계약 칸 · 본인 동의 칸 · 열람 기록 셋이 아직 없다
+ *      (`rbac.canReadParticipantReport` 가 요구하는 셋). 그 정책이 정해지기
+ *      전에는 이 함수가 그 길을 열지 않는다
+ *   4. 그 응시가 `BIZ_CORE_V1` · `PRO` 이고 굳은 결과가 있어야 한다
+ *   5. **학생 배포 플래그** `GM_STUDENT_DISTRIBUTION=yes` 가 아니면 시험 계정
+ *      (`users.is_demo`)만 받는다. KODATA 학생 배포 권리와 기업 공식 수치
+ *      원문 대조가 끝나기 전에는 이 플래그를 켜지 않는다(Track A 조건)
+ *
+ * **거절은 전부 404 로 돌려준다.** 403 을 주면 남의 번호가 있는 응시인지 알려
+ * 주는 셈이다(`attemptOf` 가 남의 번호를 404 로 돌리는 것과 같은 까닭).
+ * 까닭 코드는 서버 로그에만 남긴다.
+ *
+ * `inputs.ts` 의 옛 `canDownloadGm` 은 실험 경로(`scripts/lab/gm-student.ts`)가
+ * 쓰는 것이라 그대로 두었다. 운영 입구는 이 파일만 읽는다.
+ */
+import { queryOne } from "@/lib/db";
+import { gmEligible } from "./snapshot-inputs";
+
+export type GmDenyCode =
+  | "flag_off" | "bad_id" | "no_attempt" | "not_owner" | "org_default_deny"
+  | "not_biz_pro" | "no_result" | "distribution_off";
+
+export type GmAccess =
+  | { ok: true; who: "self"; code: "ok" }
+  | { ok: false; status: 404; code: GmDenyCode; reason: string };
+
+/** 요청한 사람. 세션 사용자(`SessionUser`)의 이 세 칸만 읽는다 */
+export type GmViewer = {
+  id: string;
+  role: string;
+  memberships: { orgId: string | null; role: string }[];
+};
+
+/** 남의 자료를 볼 수 있는 자리에 있는가(학과 담당자 · 교수 · 운영사) */
+const STAFF = new Set(["org_admin", "instructor", "superadmin"]);
+
+const deny = (code: GmDenyCode, reason: string): GmAccess =>
+  ({ ok: false, status: 404, code, reason });
+
+export async function canDownloadGm(
+  viewer: GmViewer, attemptId: string, env: NodeJS.ProcessEnv = process.env,
+): Promise<GmAccess> {
+  if (env.FEATURE_GM_REPORT !== "yes") return deny("flag_off", "GM 입구가 꺼져 있다");
+  if (!/^\d{1,18}$/.test(attemptId)) return deny("bad_id", "응시 번호 꼴이 아니다");
+  const a = await queryOne<{
+    user_id: string; core_code: string; tier: string; is_demo: boolean; has_result: boolean;
+  }>(
+    `SELECT a.user_id::text, a.core_code, a.tier, coalesce(u.is_demo, false) AS is_demo,
+            EXISTS (SELECT 1 FROM v3_snapshots s
+                     WHERE s.attempt_id = a.id AND s.result_model IS NOT NULL) AS has_result
+       FROM v3_attempts a JOIN users u ON u.id = a.user_id
+      WHERE a.id = $1`, [attemptId]);
+  if (!a) return deny("no_attempt", "없는 응시");
+  if (a.user_id !== viewer.id) {
+    const staff = STAFF.has(viewer.role) || viewer.memberships.some((m) => STAFF.has(m.role));
+    return staff
+      ? deny("org_default_deny", "담당자 개인 PDF 열람은 계약 · 동의 · 열람 기록 정책이 정해지기 전에는 거절")
+      : deny("not_owner", "본인의 응시가 아니다");
+  }
+  if (!gmEligible(a.core_code, a.tier)) return deny("not_biz_pro", `${a.core_code} · ${a.tier}`);
+  if (!a.has_result) return deny("no_result", "굳은 결과가 없다");
+  if (env.GM_STUDENT_DISTRIBUTION !== "yes" && !a.is_demo) {
+    return deny("distribution_off", "학생 배포 플래그가 꺼져 있다(KODATA 권리 · 기업 수치 대조 전)");
+  }
+  return { ok: true, who: "self", code: "ok" };
+}
