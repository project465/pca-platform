diff --git a/src/lib/me-v3/report-gm/generate.ts b/src/lib/me-v3/report-gm/generate.ts
new file mode 100644
index 00000000..38c56c45
--- /dev/null
+++ b/src/lib/me-v3/report-gm/generate.ts
@@ -0,0 +1,152 @@
+/**
+ * **운영 입구가 Gold Master PDF 한 부를 만든다**(Track E 요청 1).
+ *
+ * 실험 경로(`scripts/lab/gm-student.ts`)와 같은 차례를 밟되 운영에 맞춰 셋을 다르게 한다.
+ *
+ *   1. **입력 파일을 만들지 않는다.** 제출 때 굳힌 줄(`v3_snapshots.gm_inputs`)만
+ *      읽는다(`allowFile: false`). 그 칸이 서기 전에 굳은 응시는 `input` 에서 멈춘다
+ *   2. **그리는 HTML 을 남기지 않는다.** 실험 경로는 `var/pdf-gm/` 에 응시마다 HTML 을
+ *      두고 지우지 않았다(경험 기록 제목이 든 글이 파기 대상 밖에 남는다). 여기서는
+ *      응시 폴더 안(`gmOutDir()/{id}/`)에 두고 성공 · 실패 어느 쪽이든 지운다.
+ *      프로세스가 그 사이에 죽어도 그 폴더는 `purgeGm` 이 지우는 자리다
+ *   3. **글꼴이 없으면 만들지 않는다.** 다른 글꼴로 찍으면 쪽 넘침이 달라져 다른
+ *      종이가 된다. Pretendard 다섯 벌이 없으면 `fonts` 에서 멈춘다
+ *
+ * **덜 만든 PDF 를 남기지 않는다**(1차 E4): `.part` 로 찍고 넘친 쪽이 없을 때만
+ * 이름을 바꾼다. 실패는 걸음과 까닭을 `FAIL.json` 에 남긴다(개인정보를 담지 않는다).
+ * `MANIFEST.json` 은 재현 대조용 해시와 개수만 담는다: 빠진 기록의 제목을 적지 않는다.
+ */
+import { createHash, randomBytes } from "node:crypto";
+import { existsSync, mkdirSync, readFileSync, renameSync, rmSync, writeFileSync } from "node:fs";
+import path from "node:path";
+import { pathToFileURL } from "node:url";
+import { build3 } from "./report3";
+import { full6 } from "./render6";
+import type { Lib } from "./render5";
+import { frozenInput, gmOutDir, inputFile } from "./inputs";
+import { resolveChromium } from "@/lib/me-v3/result/pdf";
+
+export type GmStep = "input" | "fonts" | "render" | "browser" | "print" | "layout";
+export type GmBuilt =
+  | { ok: true; pdf: Buffer; file: string; manifest: Record<string, unknown> }
+  | { ok: false; step: GmStep; reason: string };
+
+/** HTML 파일 하나를 PDF 로 찍고 쪽마다 넘친 높이를 돌려준다. 검사가 바꿔 끼운다 */
+export type GmPrinter = (htmlFile: string, pdfOut: string) => Promise<number[]>;
+
+export class GmPrintFailed extends Error {
+  constructor(readonly step: "browser" | "print", message: string) { super(message); }
+}
+
+const WEIGHTS = ["Regular", "Medium", "SemiBold", "Bold", "ExtraBold"];
+const sha = (b: string | Buffer) => createHash("sha256").update(b).digest("hex");
+const J = (p: string) => JSON.parse(readFileSync(p, "utf8"));
+
+/** 글꼴 자리. 운영 이미지에서는 `GM_FONT_DIR` 이 가리킨다(요청 4 · 글꼴 결정) */
+export function gmFontDir(): string {
+  return process.env.GM_FONT_DIR ?? path.resolve("var/pdf-gm/fonts/pretendard");
+}
+
+/** 넘치면 그 쪽의 글만 줄인다(gm-student · gm-full6 과 같은 규칙 · 최대 17%) */
+const FIT_JS = `(() => {
+  const over = (pg) => { const box = pg.querySelector(".bd").getBoundingClientRect(); let max = 0;
+    for (const e of pg.querySelectorAll(".bd *")) { const b = e.getBoundingClientRect(); if (b.height) max = Math.max(max, b.bottom); }
+    return Math.round(max - box.bottom); };
+  return [...document.querySelectorAll(".pg")].map((pg) => {
+    const bd = pg.querySelector(".bd"); if (!bd) return 0;
+    let o = over(pg), z = 1;
+    while (o > 0 && z > 0.83) { z = Math.round((z - 0.01) * 100) / 100; for (const c of bd.children) c.style.zoom = String(z); o = over(pg); }
+    return o;
+  });
+})()`;
+
+/** 운영 PDF 와 같은 브라우저 자리(`resolveChromium`)를 쓴다 */
+export const chromiumPrinter: GmPrinter = async (htmlFile, pdfOut) => {
+  const { chromium } = await import("playwright");
+  const { bin, tried } = resolveChromium();
+  let b;
+  try {
+    b = await chromium.launch({
+      args: ["--no-sandbox", "--disable-dev-shm-usage"], ...(bin ? { executablePath: bin } : {}),
+    });
+  } catch (e) {
+    throw new GmPrintFailed("browser", `${String((e as Error).message).split("\n")[0]} / 찾아본 자리: ${tried.join(" ")}`);
+  }
+  try {
+    const p = await b.newPage();
+    await p.goto(pathToFileURL(htmlFile).href, { waitUntil: "load" });
+    await p.evaluate("document.fonts.ready");
+    await p.emulateMedia({ media: "print" });
+    const over = await p.evaluate(FIT_JS) as number[];
+    await p.pdf({ path: pdfOut, format: "A4", printBackground: true, preferCSSPageSize: true });
+    return over;
+  } catch (e) {
+    throw new GmPrintFailed("print", String((e as Error).message).split("\n")[0]);
+  } finally { await b.close(); }
+};
+
+export async function generateGm(
+  attemptId: string, opts: { allowFile?: boolean; print?: GmPrinter } = {},
+): Promise<GmBuilt> {
+  inputFile(attemptId); // 번호 꼴이 아니면 여기서 던진다(폴더 이름이 된다)
+  const dir = path.join(gmOutDir(), attemptId);
+  /* 같은 응시를 두 탭이 같은 순간에 눌러도 서로의 반쪽 파일을 덮지 않게 이름을 가른다 */
+  const tag = randomBytes(6).toString("hex");
+  const tmpPdf = path.join(dir, `.BIZ-PRO-${tag}.pdf.part`);
+  const tmpHtml = path.join(dir, `.render-${tag}.html`);
+  const clean = () => { rmSync(tmpPdf, { force: true }); rmSync(tmpHtml, { force: true }); };
+  const fail = (step: GmStep, reason: string): GmBuilt => {
+    clean();
+    mkdirSync(dir, { recursive: true });
+    writeFileSync(path.join(dir, "FAIL.json"), JSON.stringify(
+      { attempt_id: attemptId, step, reason: reason.slice(0, 300), at: new Date().toISOString() }, null, 1));
+    return { ok: false, step, reason };
+  };
+  /* 1 입력 — 굳은 줄만(운영은 파일을 만들지 않는다) */
+  let input;
+  try { ({ input } = await frozenInput(attemptId, { allowFile: opts.allowFile ?? false })); }
+  catch (e) { return fail("input", String((e as Error).message ?? e)); }
+  /* 2 글꼴 */
+  const fontDir = gmFontDir();
+  const missing = WEIGHTS.filter((w) => !existsSync(path.join(fontDir, `Pretendard-${w}.woff2`))
+    && !existsSync(path.join(fontDir, `Pretendard-${w}.otf`)));
+  if (missing.length) return fail("fonts", `Pretendard ${missing.join(" · ")} 없음 (${fontDir})`);
+  /* 3 렌더 */
+  let html: string; let pages: number; let skipped: number; let versions: unknown;
+  try {
+    const r = build3(input.result_model, { ...input.meta, tier: input.tier }, input.experiences);
+    const lib: Lib = {
+      toc: J("data/report-gm/biz-pro-toc.v1.json"), dart: J("data/region/dart-checks.v1.json"),
+      overview: J("data/region/dart-overview.v1.json"), roles: J("data/report-gm/biz-role-guide.json"),
+      orgs: J("data/region/kr-chungcheong-orgs.v2.json"),
+      domains: r.map.map((m) => ({ code: m.code, name: m.name })), versions: r.versions,
+    };
+    /* 글꼴은 절대 주소로 건다: HTML 을 응시 폴더에 두어도 글꼴을 찾는다 */
+    const out = full6(r, lib, { href: pathToFileURL(fontDir).href, family: "Pretendard" });
+    html = out.html; pages = out.pages.length; skipped = out.skipped.length; versions = r.versions;
+  } catch (e) { return fail("render", String((e as Error).message ?? e)); }
+  /* 4 인쇄 — HTML 은 응시 폴더 안에만 두고 어느 쪽이든 지운다 */
+  mkdirSync(dir, { recursive: true });
+  let over: number[];
+  try {
+    writeFileSync(tmpHtml, html);
+    over = await (opts.print ?? chromiumPrinter)(tmpHtml, tmpPdf);
+  } catch (e) {
+    return fail(e instanceof GmPrintFailed ? e.step : "print", String((e as Error).message ?? e));
+  } finally { rmSync(tmpHtml, { force: true }); }
+  if (over.some((o) => o > 0)) return fail("layout", `넘친 쪽 ${over.filter((o) => o > 0).length}`);
+  if (!existsSync(tmpPdf)) return fail("print", "PDF 가 만들어지지 않았다");
+  const file = path.join(dir, "BIZ-PRO.pdf");
+  renameSync(tmpPdf, file);
+  rmSync(path.join(dir, "FAIL.json"), { force: true });
+  const pdf = readFileSync(file);
+  const manifest = {
+    attempt_id: attemptId, input_source: input.source ?? "file", input_version: input.version,
+    input_sha256: input.sha256, frozen_at: input.frozen_at,
+    experiences_used: input.experiences.length, experiences_excluded: input.excluded.length,
+    pages, skipped, html_sha256: sha(html), pdf_sha256: sha(pdf), versions,
+    made_at: new Date().toISOString(),
+  };
+  writeFileSync(path.join(dir, "MANIFEST.json"), JSON.stringify(manifest, null, 1));
+  return { ok: true, pdf, file, manifest };
+}
