@@ -0,0 +1,93 @@
+/**
+ * **Gold Master PDF(BIZ PRO)를 본인에게 내려 준다**(Track E 요청 1).
+ *
+ * 운영 결과지 PDF(`/v3/{id}/result/pdf`)와 **다른 입구다.** 그쪽은 고치지 않는다.
+ *
+ * - 플래그(`FEATURE_GM_REPORT=yes`)가 꺼져 있으면 로그인보다 먼저 404 다: 입구가
+ *   있다는 것도 알리지 않는다
+ * - 권한은 `canDownloadGm` 하나가 정한다: 본인만 · BIZ_CORE_V1 PRO · 학생 배포
+ *   플래그. **기관 담당자는 기본 거절**(계약 · 동의 · 열람 기록 정책 전). 거절은
+ *   전부 404 이고 까닭 코드는 서버 로그에만 남긴다
+ * - 만든 PDF 는 `attachment` · `no-store` 로 내보낸다(중간 캐시에 남기지 않는다)
+ * - 못 만들면 걸음과 까닭을 서버 로그와 `job_failures`(`gm_pdf_fail`)에 남기고
+ *   웹 결과지로 가는 쪽을 준다. **덜 만든 PDF 는 남지 않는다**(`generateGm`)
+ */
+import { requireUser } from "@/lib/session";
+import { query } from "@/lib/db";
+import { canDownloadGm } from "@/lib/me-v3/report-gm/access";
+import { generateGm } from "@/lib/me-v3/report-gm/generate";
+
+export const dynamic = "force-dynamic";
+export const maxDuration = 120;
+
+const NOT_FOUND = () => new Response("not found", {
+  status: 404, headers: { "cache-control": "no-store" },
+});
+
+function sorryPage(attemptId: string): Response {
+  const id = encodeURIComponent(attemptId);
+  const html = `<!doctype html><html lang="ko"><head><meta charset="utf-8">
+<meta name="viewport" content="width=device-width,initial-scale=1">
+<title>Gold Master PDF · CareerMatri</title>
+<style>
+ :root { color-scheme: light }
+ body { margin:0; background:#f6f7f9; color:#1e2838;
+        font:15px/1.7 "Pretendard","Noto Sans KR",system-ui,sans-serif;
+        display:flex; min-height:100vh; align-items:center; justify-content:center; padding:24px }
+ main { max-width:520px; background:#fff; border:1px solid #e3e7ee; border-radius:16px; padding:28px }
+ h1 { margin:0 0 12px; font-size:20px; letter-spacing:-.02em }
+ p { margin:0 0 14px; color:#475569 }
+ a { display:inline-flex; align-items:center; min-height:44px; padding:0 16px; margin:6px 10px 0 0;
+     border-radius:10px; text-decoration:none; font-weight:600; font-size:14px;
+     border:1px solid #e3e7ee; color:#1e2838 }
+</style></head><body><main>
+ <h1>PDF를 만들지 못했습니다</h1>
+ <p>웹 결과는 그대로 볼 수 있습니다. 저희 쪽 기록에 남아 있어 바로 확인할 수 있습니다.</p>
+ <a href="/v3/${id}/result">웹 결과 보기</a><a href="/support">고객지원</a>
+</main></body></html>`;
+  return new Response(html, {
+    status: 503, headers: { "content-type": "text/html; charset=utf-8", "cache-control": "no-store" },
+  });
+}
+
+export async function GET(
+  _req: Request,
+  ctx: { params: Promise<{ attemptId: string }> },
+) {
+  const { attemptId } = await ctx.params;
+  if (process.env.FEATURE_GM_REPORT !== "yes") return NOT_FOUND();
+  const user = await requireUser();
+  const may = await canDownloadGm(user, attemptId);
+  if (!may.ok) {
+    /* 응시 번호와 까닭 코드만 적는다. 이름 · 이메일은 적지 않는다 */
+    console.log(`[gm-pdf] deny attempt=${attemptId.slice(0, 20)} viewer=${user.id} code=${may.code}`);
+    return NOT_FOUND();
+  }
+  const t0 = Date.now();
+  console.log(`[gm-pdf] start attempt=${attemptId} viewer=${user.id}`);
+  const r = await generateGm(attemptId, { allowFile: false }).catch((e) =>
+    ({ ok: false as const, step: "render" as const, reason: String((e as Error)?.message ?? e) }));
+  if (r.ok) {
+    console.log(`[gm-pdf] done attempt=${attemptId} ${r.pdf.length}바이트 ${Date.now() - t0}ms`);
+    return new Response(new Uint8Array(r.pdf), {
+      headers: {
+        "content-type": "application/pdf",
+        "content-disposition": `attachment; filename="careermatri-gm-BIZ-PRO-${attemptId}.pdf"`,
+        "cache-control": "private, no-store",
+      },
+    });
+  }
+  /**
+   * **왜 못 만들었는지를 버리지 않는다**(운영 결과지 PDF 경로와 같은 규칙).
+   * `attempt_id` 칸은 옛 응시 표를 가리키는 외래키라 V3 번호를 넣지 않고
+   * `trace_id` 가 든다. 적는 자리가 막힌 것도 서버 로그에 남긴다.
+   */
+  const line = `[gm-pdf] attempt=${attemptId} step=${r.step} ${Date.now() - t0}ms :: `
+    + r.reason.split("\n")[0].slice(0, 300);
+  console.error(line);
+  await query(
+    `INSERT INTO job_failures (kind, trace_id, message) VALUES ('gm_pdf_fail', $1, $2)`,
+    [`gm-pdf-${r.step}-${attemptId}`, line.slice(0, 400)],
+  ).catch((err) => console.error(`[gm-pdf] 운영 표에 못 적었습니다: ${String(err).slice(0, 200)}`));
+  return sorryPage(attemptId);
+}
