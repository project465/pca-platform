@@ -57,8 +57,12 @@ services:
       # 결과지 PDF 가 사는 자리. **컨테이너 안에 두지 않는다**:
       # 배포할 때마다 사라지고, 산 사람이 어제 받은 PDF 를 다시 못 받는다
       REPORT_PDF_DIR: /var/reports
+      # Gold Master PDF. 결과지 볼륨과 **따로** 둔다: 파기 · 보존 규칙을 따로 센다
+      GM_OUT: /app/var/gm/out
+      GM_INPUT_DIR: /app/var/gm/inputs
     volumes:
       - reports:/var/reports
+      - gm:/app/var/gm
     depends_on:
       db: { condition: service_healthy }
     # 앞단(Caddy·nginx·클라우드 LB)이 인증서와 도메인을 맡는다
@@ -120,6 +124,9 @@ volumes:
   dbdata:
   # 결과지 PDF. 배포와 무관하게 남아야 한다
   reports:
+  # Gold Master PDF. **백업하지 않는다**: 굳은 줄(`v3_snapshots.gm_inputs`)에서 다시 만들
+  # 수 있고, 백업에 한 벌 더 두면 탈퇴 파기가 닿지 않는 사본이 생긴다
+  gm:
   # 받아 둔 백업. 같은 디스크에 두는 것은 임시다:
   # 디스크가 통째로 죽는 날 백업도 같이 죽는다. 밖으로 복사할 것
   backups:
diff --git a/deploy/entrypoint.sh b/deploy/entrypoint.sh
index edd23756..b12f0827 100755
--- a/deploy/entrypoint.sh
+++ b/deploy/entrypoint.sh
@@ -11,9 +11,14 @@ set -e
 
 DIR="${REPORT_PDF_DIR:-/app/var/reports}"
 mkdir -p "$DIR"
+# Gold Master 볼륨. **못 써도 멈추지 않는다**: 기능 플래그가 꺼져 있으면 쓰지 않는
+# 자리이고, 켠 뒤 못 쓰면 입구가 그 걸음을 `job_failures` 에 남긴다
+GM="$(dirname "${GM_OUT:-/app/var/gm/out}")"
+mkdir -p "${GM_OUT:-/app/var/gm/out}" 2>/dev/null || true
 
 if [ "$(id -u)" = "0" ]; then
   chown -R metri:nodejs "$DIR" 2>/dev/null || true
+  chown -R metri:nodejs "$GM" 2>/dev/null || true
   # 쓸 수 있는지 **실제로 써 본다.** 못 쓰면 지금 멈추는 쪽이
   # 결제 뒤에 멈추는 것보다 싸다
   su-exec metri sh -c "touch '$DIR/.w' && rm -f '$DIR/.w'" || {
