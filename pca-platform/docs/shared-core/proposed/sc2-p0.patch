+ */
+export const BARE_LOGIN_UNIVERSITIES: ReadonlySet<string> = new Set(["PCU"]);
+
+export function defaultLoginId(universityCode: string, sid: string): string {
+  return BARE_LOGIN_UNIVERSITIES.has(universityCode) ? sid : `${universityCode}:${sid}`;
+}
