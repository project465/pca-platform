+  readonly code: "LOGIN_TAKEN" | "EMAIL_TAKEN";
+  constructor(code: "LOGIN_TAKEN" | "EMAIL_TAKEN", message: string) {
+    super(message);
+    this.name = "CampusProvisionRejected";
+    this.code = code;
+  }
+}
