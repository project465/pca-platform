    export async function provisionStudent(
      orgId: string, checked: Checked,
      opts: { rotate?: boolean } = {},
    ): Promise<{ created: boolean; password: string | null; userId: string }> {
      const { input, loginId, ctx } = checked;
      /* **(학교, 학번)으로만 찾는다.** 손잡이(login_id)로 찾으면 다른 학교의 같은
         학번이나 학교가 발급하지 않은 계정을 같은 사람으로 읽는다(R36 P0) */
      const mine = await queryOne<{ id: string }>(
        `SELECT user_id::text AS id FROM campus_students
          WHERE university_code = $1 AND student_id = $2`,
        [ctx.university_code, input.student_id]);
      if (mine && !opts.rotate) {
        /* 학과가 바뀌었을 수 있으므로 그 줄은 맞춰 둔다. 열쇠만 그대로다 */
        await query(
          `UPDATE campus_students
              SET college_code = $2, department_code = $3, specialization = $4
            WHERE user_id = $1::bigint AND university_code = $5`,
          [mine.id, ctx.college_code, ctx.department_code, ctx.specialization,
            ctx.university_code]);
        return { created: false, password: null, userId: mine.id };
      }
    
      /* 손잡이와 메일을 다른 사람이 들고 있으면 **가져가지 않는다** */
      const holder = await queryOne<{ id: string }>(
        `SELECT id::text FROM users WHERE login_id = $1`, [loginId]);
      if (holder && holder.id !== mine?.id) {
        throw new CampusProvisionRejected("LOGIN_TAKEN",
          `아이디가 이미 다른 계정에 있습니다: ${loginId}`);
      }
      const email = input.email?.trim() || null;
      if (email) {
        const em = await queryOne<{ id: string }>(
          `SELECT id::text FROM users WHERE lower(email) = lower($1)`, [email]);
        if (em && em.id !== mine?.id) {
          throw new CampusProvisionRejected("EMAIL_TAKEN", "메일 주소가 이미 다른 계정에 있습니다");
        }
      }
    
      const pw = initialPassword();
      const hash = await hashPassword(pw);
      const user = mine
        ? await queryOne<{ id: string; is_demo: boolean }>(
          `UPDATE users SET password_hash = $2, display_name = $3
            WHERE id = $1::bigint RETURNING id::text, is_demo`,
          [mine.id, hash, input.name.trim()])
        : await queryOne<{ id: string; is_demo: boolean }>(
          `INSERT INTO users (login_id, email, display_name, password_hash,
                              status, locale, must_reset_pw)
           VALUES ($1, $2, $3, $4, 'active', 'ko', FALSE)
           RETURNING id::text, is_demo`,
          [loginId, email, input.name.trim(), hash]);
      if (!user) throw new Error(`계정을 만들지 못했습니다: ${loginId}`);
      /* **학생을 시연으로 표시하지 않는다.** 사람을 만드는 자리가 스무 곳이
         넘어 트리거가 아이디 모양만 보고 표시할 수 있고, 그 자리는 운영
         지표에서 걸러지므로 담당자 화면의 수가 비어 보인다 */
      if (user.is_demo) {
        await query(`UPDATE users SET is_demo = FALSE WHERE id = $1::bigint`,
          [user.id]);
      }
    
      /* 소속은 `memberships` 가 든다. 역할은 전부터 있던 `student` 다 */
      await query(
        `INSERT INTO memberships (user_id, org_id, role)
         VALUES ($1::bigint, $2::bigint, 'student')
         ON CONFLICT (user_id, org_id, role) DO NOTHING`,
        [user.id, orgId]);
    
      /* **다른 학교의 줄을 고쳐 쓰지 않는다.** 같은 (학교, 학번)일 때만 맞춘다 */
      await query(
        `INSERT INTO campus_students (user_id, university_code, student_id,
                                      college_code, department_code, specialization)
         VALUES ($1::bigint, $2, $3, $4, $5, $6)
         ON CONFLICT (user_id) DO UPDATE
           SET college_code    = EXCLUDED.college_code,
               department_code = EXCLUDED.department_code,
               specialization  = EXCLUDED.specialization
         WHERE campus_students.university_code = EXCLUDED.university_code
           AND campus_students.student_id      = EXCLUDED.student_id`,
        [user.id, ctx.university_code, input.student_id,
          ctx.college_code, ctx.department_code, ctx.specialization]);
    
      return { created: !mine, password: pw, userId: user.id };
