# 공개 전 시험 배포(staging)용 환경변수.
#
# **운영과 같은 파일을 쓰지 않는다.** 한 파일을 돌려 쓰면 어느 날 운영에
# 가짜 결제가 켜져 있다. 값을 지어내지 않았다: 비어 있으면 그 기능이
# 꺼지고, 꺼진 것은 화면과 `launch:check` 가 적는다.

# ── 이 배포본이 무엇인가. **이 한 줄이 가짜 결제의 문을 연다** ──────
APP_ENV=staging

# ── 반드시 있어야 하는 것 ────────────────────────────────────────
DATABASE_URL=postgres://metri:비밀번호@db:5432/metri
POSTGRES_PASSWORD=
# `openssl rand -base64 48`
AUTH_SECRET=

# ── 공개 전 자물쇠. `아이디:비밀번호` 한 줄 ──────────────────────
# 비우면 자물쇠가 없다. 주소를 아는 사람만 막는 것은 자물쇠가 아니다
STAGING_BASIC_AUTH=qa:여기에-긴-비밀번호

# ── 이 배포본의 주소 ────────────────────────────────────────────
# 메일 링크와 결제 콜백이 이 값을 쓴다. staging 에서는 소개 사이트의
# 정규 주소보다 이쪽이 먼저다(저쪽에는 아직 플랫폼이 없다)
PLATFORM_URL=https://app.careermatri.com

# ── 결제. staging 에서는 비워 둔다(가짜로 받는다) ────────────────
# **운영에서는 비우면 서버가 뜨지 않는다**
PAYMENTS_PROVIDER=

# ── 메일. 비어 있으면 보내지 않고 대기열에만 쌓는다 ──────────────
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=

# ── 밤 당번이 쓰는 토큰. 16자 미만이면 그 주소가 열리지 않는다 ───
OPS_TOKEN=

# ── 운영 DB 인가. 세션이 끝나면 사라지는 DB 는 운영이 아니다 ─────
DB_IS_PERSISTENT=yes
